# 本地开发可以留空；部署时必须设置随机密钥，绝不能提交真实 .env。
SECRET_KEY=
APP_ENV=development
DATABASE_PATH=instance/notebook.sqlite3
UPLOAD_FOLDER=instance/uploads
TZ=Asia/Shanghai
HOST=127.0.0.1
PORT=5000
SESSION_COOKIE_SECURE=false
REGISTER_ENABLED=true
MAX_CONTENT_LENGTH=16777216
# 仅管理员信任的公网 HTTPS 模型服务，逗号分隔；自定义服务需在此加入域名。
# 用户的 AI API Key 只存浏览器，不要填进服务器 .env。
AI_ALLOWED_HOSTS=api.deepseek.com,api.openai.com
